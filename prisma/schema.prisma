generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CLIENT
}

enum ProductType {
  NEW
  USED
  ACCESSORY
}

enum ProductCatalogType {
  DEVICE
  SPARE_PART
  ACCESSORY
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  HIDDEN
}

enum ProductCondition {
  NEW
  SEMINUEVO
  REFURBISHED
  REPAIRED
  FOR_PARTS
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  RETURN
}

enum ExternalReviewSource {
  GOOGLE_MAPS
  TRUSTPILOT
  FACEBOOK
  INTERNAL
}

enum LeadStatus {
  PENDING
  CONTACTED
  SOLD
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryMovements InventoryMovement[]
  confirmedLeads     Lead[]              @relation("LeadConfirmedBy")
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models      PhoneModel[]
  phoneSeries PhoneSeries[]
  products    Product[]
}

model Category {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  icon        String?
  catalogType ProductCatalogType @default(DEVICE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  products Product[]

  @@index([catalogType])
}

model PhoneSeries {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models   PhoneModel[]
  products Product[]

  @@index([brandId])
  @@index([isActive])
}

/// Condiciones administrables. Tabla física `product_conditions_catalog` (evita conflicto con enum `ProductCondition`).
model ProductConditionCatalog {
  id          String             @id @default(uuid())
  name        String
  slug        String
  description String?
  catalogType ProductCatalogType
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  products Product[]

  @@unique([slug, catalogType])
  @@index([catalogType])
  @@index([isActive])
  @@map("product_conditions_catalog")
}

/// Grados administrables. Tabla física `product_grades_catalog` (evita conflictos con tipos legacy).
model ProductGrade {
  id          String             @id @default(uuid())
  name        String
  description String?
  catalogType ProductCatalogType
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  products Product[]

  @@unique([name, catalogType])
  @@index([catalogType])
  @@index([isActive])
  @@map("product_grades_catalog")
}

model PhoneModel {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  seriesId  String?
  series    PhoneSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([brandId])
  @@index([seriesId])
}

model Product {
  id             String            @id @default(uuid())
  name           String
  slug           String            @unique
  sku            String            @unique
  description    String?
  price          Decimal           @db.Decimal(12, 2)
  comparePrice   Decimal?          @db.Decimal(12, 2)
  type           ProductType
  catalogType    ProductCatalogType @default(DEVICE)
  condition      ProductCondition
  conditionId    String?
  conditionRef   ProductConditionCatalog? @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  stock          Int               @default(0)
  minStock       Int               @default(0)
  brandId        String
  brand          Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId     String
  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modelId        String?
  model          PhoneModel?       @relation(fields: [modelId], references: [id], onDelete: SetNull)
  storage        String?
  color          String?
  colorHex       String?
  batteryHealth  Int?
  grade          String?
  gradeId        String?
  gradeRef       ProductGrade?     @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  seriesId       String?
  series         PhoneSeries?      @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  isFeatured     Boolean           @default(false)
  isPublished    Boolean           @default(false)
  status         ProductStatus     @default(ACTIVE)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  inventoryMovements InventoryMovement[]
  productImages      ProductImage[]

  @@index([brandId])
  @@index([categoryId])
  @@index([catalogType])
  @@index([conditionId])
  @@index([gradeId])
  @@index([seriesId])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([status])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([isPrimary])
}

model InventoryMovement {
  id            String                @id @default(uuid())
  productId     String
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          InventoryMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  notes         String?
  createdById   String
  createdBy     User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now())

  @@index([productId])
  @@index([createdById])
}

model Lead {
  id           String      @id @default(uuid())
  products     Json
  total        Decimal     @db.Decimal(12, 2)
  phone        String?
  customerName String?
  notes        String?
  status       LeadStatus  @default(PENDING)
  confirmedById String?
  confirmedBy  User?       @relation("LeadConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  soldAt       DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Reseñas agregadas desde fuentes externas (Google, Trustpilot, etc.).
model ExternalReview {
  id           String               @id @default(uuid())
  source       ExternalReviewSource
  authorName   String
  authorPhoto  String?
  rating       Int
  text         String               @db.Text
  relativeTime String?
  /// Para Google se fija con `time` de la API; otras fuentes pueden usar el default.
  createdAt    DateTime               @default(now())

  @@index([source, createdAt(sort: Desc)])
}

/// Totales oficiales devueltos por la API del proveedor (p. ej. rating y user_ratings_total de Google).
model ExternalReviewSummary {
  source         ExternalReviewSource @id
  averageRating  Decimal?             @db.Decimal(3, 2)
  totalReviews   Int?
  lastSyncedAt   DateTime?
  updatedAt      DateTime             @updatedAt
}
